# ============================================================================
# Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file with real credentials to version control!
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your API keys in the .env file
#   3. The app will automatically load these when running
# ============================================================================

# -----------------------------------------------------------------------------
# Anthropic API Key
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
# Required for: Claude Sonnet, Claude Opus models
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# -----------------------------------------------------------------------------
# OpenAI API Key (Optional)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Required for: GPT-4, GPT-4 Turbo, GPT-4 Vision models
# OPENAI_API_KEY=sk-YOUR_KEY_HERE

# -----------------------------------------------------------------------------
# AWS Credentials for Bedrock (Optional)
# -----------------------------------------------------------------------------
# RECOMMENDED: Configure AWS credentials in ~/.aws/credentials using AWS CLI
#   Run: aws configure
#   This will create ~/.aws/credentials with your access keys
#
# ALTERNATIVE: Set environment variables (less secure, not recommended)
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=us-east-1
#
# The boto3 client will automatically use credentials in this order:
#   1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
#   2. ~/.aws/credentials file (created by 'aws configure')
#   3. IAM role (if running on EC2/ECS/Lambda)

# ============================================================================
# Notes:
# ============================================================================
# - Only ANTHROPIC_API_KEY is required by default (default provider)
# - Set other keys only if you want to use those providers
# - For Bedrock, IAM roles are more secure than access keys
# - Keep your .env file out of version control (add to .gitignore)
# ============================================================================
