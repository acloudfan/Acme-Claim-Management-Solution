api:
  title: Insurance Claims API
  version: v1
  debug: true
  host: 0.0.0.0
  port: 8000
database:
  url: sqlite:///./test_insurance.db
  pool_size: 5
  max_overflow: 10
  echo: false
storage:
  images_root_folder: uploads
  max_upload_size_mb: 10
  allowed_image_types:
  - jpg
  - jpeg
  - png
  - heic
  max_images_per_claim: 20
ai:
  yolo:
    model_source: huggingface
    model_path: vineetsarpal/yolov11n-car-damage
    confidence_threshold: 0.25
    device: cpu
    save_annotated_images: true
    annotated_image_prefix: BB-
  sop_claims_document: policies/damage_triage.md
  claims_rules_yaml: policies/rules.yaml
  confidence:
    high_threshold: 0.55
    low_threshold: 0.35
  fraud:
    risk_threshold: 0.1
  estimate:
    human_review_threshold: 5000
logging:
  level: INFO
  file: logs/api.log
  max_bytes: 10485760
  backup_count: 5
  format: '%(asctime)s | %(levelname)-8s | %(name)s | %(message)s'
cors:
  allow_origins:
  - http://localhost:5173
  - http://localhost:5174
  - http://localhost:5170
  - http://localhost:5176
  allow_credentials: false
  allow_methods:
  - '*'
  allow_headers:
  - '*'
llm:
  default_provider: bedrock
  default_vision_model: bedrock
  providers:
    anthropic:
      enabled: false
      api_key_env: ANTHROPIC_API_KEY
      base_url: https://api.anthropic.com
      default_model: claude-sonnet-4.5-20250929
      timeout_s: 60
      max_tokens: 4096
      temperature: 0.2
    openai:
      enabled: true
      api_key_env: OPENAI_API_KEY
      base_url: https://api.openai.com/v1
      default_model: gpt-4o
      timeout_s: 60
      max_tokens: 4096
      temperature: 0.2
    bedrock:
      enabled: true
      aws_region: us-east-1
      default_model: us.anthropic.claude-sonnet-4-5-20250929-v1:0
      timeout_s: 60
      max_tokens: 4096
      temperature: 0.2
agents:
  supervisor:
    enabled: true
    parallel_execution: true
    timeout_s: 30
  fraud_detector:
    enabled: true
    model_override: null
    skip_phase3_high_threshold: 0.8
    skip_phase3_low_threshold: 0.3
    high_risk_threshold: 0.7
    medium_risk_threshold: 0.4
    phase1_vision:
      color_verification:
        enabled: false
        weight: 0.25
      make_model_verification:
        enabled: true
        weight: 0.3
      ai_generated_detection:
        enabled: true
        weight: 0.25
      manipulation_detection:
        enabled: false
        weight: 0.2
    phase2_static:
      vin_format_weight: 0.15
      vin_year_weight: 0.25
      claim_frequency_weight: 0.3
      claim_velocity_weight: 0.3
    phase3_behavioral:
      enabled: true
      weight: 0.4
  risk_estimator:
    enabled: false
    deviation_threshold: 0.1
  damage_analyzer:
    enabled: true
    enhance_all_damages: false
  chatbot:
    enabled: true
    model_override: claude-sonnet-4.5-20250929
    max_conversation_turns: 50
    tool_use_enabled: true
    knowledge_base_path: data/faq_knowledge_base.json
  estimate_explainer:
    enabled: true
  shop_recommender:
    enabled: false
    shops_database_path: data/repair_shops.json
    max_recommendations: 3
tracking:
  usage_logging_enabled: true
  log_to_database: true
  cost_estimates:
    anthropic_claude_sonnet_input: 3
    anthropic_claude_sonnet_output: 15
    anthropic_claude_opus_input: 15
    anthropic_claude_opus_output: 75
    openai_gpt4_turbo_input: 10
    openai_gpt4_turbo_output: 30
    bedrock_claude_3_sonnet_input: 3
    bedrock_claude_3_sonnet_output: 15
    bedrock_claude_3_opus_input: 15
    bedrock_claude_3_opus_output: 75
    bedrock_claude_3_haiku_input: 0.25
    bedrock_claude_3_haiku_output: 1.25
