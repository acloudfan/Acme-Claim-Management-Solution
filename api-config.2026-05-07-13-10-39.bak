# ============================================================================
# Insurance Claims API - Configuration File
# ============================================================================
# Copy this file to api-config.yaml and customize for your environment
# DO NOT commit api-config.yaml with sensitive data (database passwords, etc.)

# API Configuration
api:
  title: "Insurance Claims API"
  version: "v1"
  debug: true              # Set to false in production
  host: "0.0.0.0"         # Use "localhost" for local development only
  port: 8000

# Database Configuration
database:
  # SQLAnywhere connection string
  # Format: sqlanywhere://user:password@host:port/database
  url: "sqlite:///./test_insurance.db"
  pool_size: 5            # Connection pool size
  max_overflow: 10        # Max overflow connections
  echo: false             # Set to true to log all SQL queries (debug only)

# Image Storage Configuration
storage:
  # Root directory for storing claim images
  # Structure: {images_root_folder}/{claim_id}/{filename}
  images_root_folder: "uploads"

  # File upload limits
  max_upload_size_mb: 10
  allowed_image_types:
    - "jpg"
    - "jpeg"
    - "png"
    - "heic"
  max_images_per_claim: 20

# AI and State Machine Configuration
ai:
  # YOLO Model Configuration
  yolo:
    model_source: "huggingface"  # Options: huggingface, local
    model_path: "vineetsarpal/yolov11n-car-damage"  # HuggingFace repo or local path
    confidence_threshold: 0.25  # Minimum confidence for detections (0.0-1.0) - lowered to detect more damages
    device: "cpu"  # Options: cpu, cuda, mps (Apple Silicon)
    save_annotated_images: true  # Save images with bounding boxes drawn
    annotated_image_prefix: "BB-"  # Prefix for annotated image filenames

  # Path to Standard Operating Procedures (SOP) document
  # Contains instructions for AI agent decision-making
  sop_claims_document: "policies/damage_triage.md"

  # Path to claims rules YAML file
  # Contains all business rules and thresholds
  claims_rules_yaml: "policies/rules.yaml"

  # Inline thresholds (can be overridden by claims_rules_yaml)
  confidence:
    high_threshold: 0.55   # Above: auto-present to customer
    low_threshold: 0.35    # Below: route to traditional

  fraud:
    risk_threshold: 0.1    # Above: flag for human review

  estimate:
    human_review_threshold: 5000.00  # Dollar amount threshold

# Logging Configuration
logging:
  level: "INFO"           # DEBUG, INFO, WARNING, ERROR, CRITICAL
  file: "logs/api.log"
  max_bytes: 10485760     # 10MB per log file
  backup_count: 5         # Keep 5 backup files
  format: "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"

# CORS Configuration (Cross-Origin Resource Sharing)
cors:
  allow_origins:
    - "http://localhost:5173"  # Customer portal
    - "http://localhost:5174"  # Adjustor portal
    - "http://localhost:5170"  # Admin portal
  allow_credentials: false  # Using custom headers, not cookies
  allow_methods:
    - "*"
  allow_headers:
    - "*"

# LLM and Agent Configuration
# MUST set appropriate default provider for your environment
llm:
  default_provider: "bedrock"  # Options: anthropic, openai, bedrock
  default_vision_model: "bedrock"  # Vision model for image analysis (anthropic, openai, bedrock)

  providers:
    anthropic:
      enabled: false
      api_key_env: "ANTHROPIC_API_KEY"  # Read from environment
      base_url: "https://api.anthropic.com"
      default_model: "claude-sonnet-4.5-20250929"
      timeout_s: 60
      max_tokens: 4096
      temperature: 0.2

    openai:
      enabled: true
      api_key_env: "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"
      base_url: "https://api.openai.com/v1"
      default_model: "gpt-4o"
      timeout_s: 60
      max_tokens: 4096
      temperature: 0.2

    bedrock:
      enabled: true
      aws_region: "us-east-1"
      # Authentication: uses boto3 default credential chain
      # (environment vars, IAM role, AWS config file)
      # Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in environment
      default_model: "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
      # Available models:
      # - anthropic.claude-3-opus-20240229-v1:0
      # - anthropic.claude-3-sonnet-20240229-v1:0
      # - anthropic.claude-3-haiku-20240307-v1:0
      # - amazon.titan-text-express-v1
      # - meta.llama3-70b-instruct-v1:0
      timeout_s: 60
      max_tokens: 4096
      temperature: 0.2

agents:
  supervisor:
    enabled: true
    parallel_execution: true
    timeout_s: 30

  fraud_detector:
    enabled: false
    model_override: null  # Use default vision model for vision tasks, default provider for text

    # Phase 1 & 2 combined risk score thresholds (determines if Phase 3 is needed)
    skip_phase3_high_threshold: 0.8   # ≥0.8: Clear high risk, skip Phase 3 behavioral analysis
    skip_phase3_low_threshold: 0.3    # <0.3: Clear low risk, skip Phase 3 behavioral analysis
    # Range 0.3-0.8: Borderline, proceed to Phase 3 for deeper behavioral analysis

    # Final risk decision thresholds (after all phases complete)
    high_risk_threshold: 0.7          # ≥0.7: HIGH RISK - Recommend REJECT
    medium_risk_threshold: 0.4        # 0.4-0.7: MEDIUM RISK - Recommend human review
    # <0.4: LOW RISK - Recommend APPROVE

    # Phase-specific configurations
    phase1_vision:
      color_verification:
        enabled: true                 # Enable/disable color mismatch detection
        weight: 0.25                  # Weight when enabled (0 risk if disabled)
      make_model_verification:
        enabled: true                 # Enable/disable make/model verification
        weight: 0.30
      ai_generated_detection:
        enabled: true                 # Enable/disable AI-generated image detection
        weight: 0.25
      manipulation_detection:
        enabled: true                 # Enable/disable image manipulation detection
        weight: 0.20

    phase2_static:
      vin_format_weight: 0.15            # Weight for VIN format validation (TODO)
      vin_year_weight: 0.25              # Weight for VIN-year consistency (TODO)
      claim_frequency_weight: 0.30       # Weight for claim frequency check (TODO)
      claim_velocity_weight: 0.30        # Weight for claim velocity check (TODO)

    phase3_behavioral:
      enabled: true                      # Enable Phase 3 for borderline cases
      weight: 0.40                       # Weight of behavioral analysis in final score
      # Higher weight because behavioral patterns are strong fraud indicators

  risk_estimator:
    enabled: false
    deviation_threshold: 0.10  # 10% deviation

  # NOTE: ai_image_detector config is REDUNDANT and not used
  # AI image detection is controlled via: agents.fraud_detector.phase1_vision.ai_generated_detection.enabled
  # ai_image_detector:
  #   enabled: true
  #   probability_threshold: 0.6

  # NOTE: damage_analyzer NOT IMPLEMENTED YET - Coming Soon
  # Agent will refine YOLO severity scores, estimate internal damage, recommend repair strategies
  # damage_analyzer:
  #   enabled: false
  #   enhance_all_damages: false

  chatbot:
    enabled: true
    model_override: "claude-sonnet-4.5-20250929"
    max_conversation_turns: 50
    tool_use_enabled: true
    knowledge_base_path: "data/faq_knowledge_base.json"

  estimate_explainer:
    enabled: true

  shop_recommender:
    enabled: false  # Not implemented yet
    shops_database_path: "data/repair_shops.json"
    max_recommendations: 3

tracking:
  usage_logging_enabled: true
  log_to_database: true

  # Cost estimates (USD per 1M tokens)
  cost_estimates:
    anthropic_claude_sonnet_input: 3.00
    anthropic_claude_sonnet_output: 15.00
    anthropic_claude_opus_input: 15.00
    anthropic_claude_opus_output: 75.00
    openai_gpt4_turbo_input: 10.00
    openai_gpt4_turbo_output: 30.00
    bedrock_claude_3_sonnet_input: 3.00
    bedrock_claude_3_sonnet_output: 15.00
    bedrock_claude_3_opus_input: 15.00
    bedrock_claude_3_opus_output: 75.00
    bedrock_claude_3_haiku_input: 0.25
    bedrock_claude_3_haiku_output: 1.25

# ============================================================================
# Notes:
# - This is a PROTOTYPE configuration with NO SECURITY
# - Do NOT use in production
# - All endpoints are publicly accessible
# - Use only in isolated development/demo environments
# ============================================================================
